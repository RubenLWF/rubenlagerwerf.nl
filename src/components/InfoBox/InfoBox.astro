---
import { Picture } from "astro:assets";
import { FaLinkedin, FaGithub, FaEnvelope } from "react-icons/fa";
import { FaLocationDot } from "react-icons/fa6";

import Ruben from "../../assets/images/Ruben.png";

import Underline from "./Svg/Underline.astro";
import RubenText from "./Svg/RubenText.astro";
import NowPlaying from "../NowPlaying/NowPlaying";

const words = [
  "Developer",
  "Student",
  "Tech Enthusiast",
  "Critical Thinker",
  "Software Engineer",
  "Tinkerer",
  "Perfectionist",
  "Problem Solver",
];

// The first word is repeated at the end so the loop restarts without a visible jump.
const rollerWords = [...words, words[0]];

// Screen readers get one sentence instead of the animated list, which is hidden from them.
const wordsSentence = `I am a ${new Intl.ListFormat("en", { type: "conjunction" }).format(words)}.`;

const HOLD_MS = 1300;
const SLIDE_MS = 500;
const WORD_HEIGHT_REM = 3; // h-12
const stepMs = HOLD_MS + SLIDE_MS;
const cycleMs = stepMs * words.length;
const percent = (ms: number) => `${((ms / cycleMs) * 100).toFixed(3)}%`;
const rollerKeyframes = words
  .map(
    (_, i) =>
      `${percent(i * stepMs + HOLD_MS)} { transform: translateY(-${i * WORD_HEIGHT_REM}rem); }` +
      `${percent((i + 1) * stepMs)} { transform: translateY(-${(i + 1) * WORD_HEIGHT_REM}rem); }`,
  )
  .join("\n");
const rollerCss = `
@keyframes word-roller {
  0% { transform: translateY(0); }
  ${rollerKeyframes}
}
.word-roller {
  animation: word-roller ${cycleMs}ms cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
@media (prefers-reduced-motion: reduce) {
  .word-roller { animation: none; }
}`;
---

<Fragment set:html={`<style>${rollerCss}</style>`} />

<div class="info-box bg-primary shadow-lg rounded-4xl w-full max-w-lg lg:max-w-220">
  <div class="w-full h-full flex flex-col text-white rounded-lg p-4">
    {/* Title */}
    <h1 class="text-3xl sm:text-4xl lg:text-5xl align-middle text-center">
      Hi, I am{" "}
      <span class="relative inline-block font-bold">
        Ruben Lagerwerf
        <Underline />
      </span>
    </h1>
    <div class="flex flex-col lg:flex-row justify-center flex-1 w-full mt-2">
      {/* Image and SVG text; on desktop the photo sits at the bottom so it lines up with the Spotify widget */}
      <div class="lg:w-1/2 flex flex-col m-2 justify-center lg:justify-end">
        <div class="relative w-full flex justify-center items-center">
          <Picture
            src={Ruben}
            alt="Portrait of Ruben Lagerwerf"
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[420, 840]}
            sizes="(min-width: 1024px) 410px, (min-width: 544px) 464px, calc(100vw - 80px)"
            priority
            class="block w-full object-scale-down rounded-4xl"
          />
          <div class="absolute left-3 -bottom-3 w-2/3 flex justify-center pointer-events-none">
            <RubenText />
          </div>
        </div>
      </div>
      {/* Text */}
      <div class="lg:w-1/2 text-white flex flex-col m-2">
        <div class="justify-between flex flex-col gap-4 flex-1 py-4 lg:px-4">
          {/* Scrolling text */}
          <div class="flex items-center">
            <span class="sr-only">{wordsSentence}</span>
            <span class="text-xl sm:text-3xl mr-2 whitespace-nowrap" aria-hidden="true">I am a</span>
            <div class="overflow-hidden h-12 relative" aria-hidden="true">
              <div class="word-roller">
                {rollerWords.map((word) => (
                  <span class="text-xl sm:text-3xl font-bold h-12 flex items-center text-secondary whitespace-nowrap">
                    {word}
                  </span>
                ))}
              </div>
            </div>
          </div>
          {/* Description */}
          <p>
            Currently pursuing a Master's in Cybersecurity at{" "}
            <a
              class="text-secondary underline underline-offset-2 hover:text-accent transition-colors"
              href="https://educationguide.tue.nl/programs/graduate-school/special-masters-tracks/special-masters-track-cybersecurity"
              target="_blank"
              rel="noopener noreferrer"
            >
              Eindhoven University of Technology
            </a>
            {" "}and functioning as the Digital Innovation Officer at{" "}
            <a
              class="text-secondary underline underline-offset-2 hover:text-accent transition-colors"
              href="https://gewis.nl/en/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Study Association GEWIS
            </a>.
          </p>
          {/* Location */}
          <div class="flex items-center justify-center w-full">
            <FaLocationDot className="text-accent w-6 h-6 mr-2" aria-hidden="true" />
            <p class="text-lg">Based in Eindhoven</p>
          </div>
          {/* Links */}
          <div class="items-center w-full">
            <div class="w-2/3 mx-auto flex justify-between">
              <a
                href="https://www.linkedin.com/in/ruben-lagerwerf/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="flex-1 flex justify-center"
              >
                <FaLinkedin className="w-7 h-7 text-secondary hover:text-accent transition-colors" />
              </a>
              <a
                href="https://github.com/RubenLWF"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="flex-1 flex justify-center"
              >
                <FaGithub className="w-7 h-7 text-secondary hover:text-accent transition-colors" />
              </a>
              <a
                href="mailto:contact@rubenlagerwerf.nl"
                aria-label="Email"
                class="flex-1 flex justify-center"
              >
                <FaEnvelope className="w-7 h-7 text-secondary hover:text-accent transition-colors" />
              </a>
            </div>
          </div>
        </div>
        {/* Now Playing Component */}
        <div class="mt-auto">
          <NowPlaying client:load />
        </div>
      </div>
    </div>
  </div>
</div>
